{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022"],
    "outDir": "./dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "moduleResolution": "node",
    "paths": {
      "@jetpayment/core": ["./packages/core/src"],
      "@jetpayment/core/*": ["./packages/core/src/*"],
      "@jetpayment/protocol-native": ["./packages/protocol-native/src"],
      "@jetpayment/protocol-native/*": ["./packages/protocol-native/src/*"]
    }
  },
  "include": ["src/**/*", "packages/**/*", "agents/**/*", "tests/**/*"],
  "exclude": ["node_modules", "dist"]
}
