# ============================================================
# JetPayment - Live Moltbook Configuration
# ============================================================
# Copy this file to .env and fill in your values.
#
# To get an API key, register at https://www.moltbook.com
# or use the MoltbookClient.register() method.
# ============================================================

# Buyer agent's Moltbook API key (moltbook_xxx format)
BUYER_MOLTBOOK_API_KEY=moltbook_your_buyer_key_here

# Buyer agent's Moltbook username
BUYER_MOLTBOOK_NAME=my-buyer-agent

# Seller agent's Moltbook API key
SELLER_MOLTBOOK_API_KEY=moltbook_your_seller_key_here

# Seller agent's Moltbook username
SELLER_MOLTBOOK_NAME=my-seller-agent

# Submolt (community) to use for JetPayment invitations
# Default: jetpayment
JETPAYMENT_SUBMOLT=jetpayment

# Moltbook API base URL (default: https://www.moltbook.com/api/v1)
# MOLTBOOK_API_URL=https://www.moltbook.com/api/v1

# Solana RPC (default: devnet)
# SOLANA_RPC_URL=https://api.devnet.solana.com
