{
  "name": "jetpayment",
  "version": "0.1.0",
  "description": "JetPayment: Autonomous AI Agent Payment Architecture — Multi-protocol Monorepo",
  "private": true,
  "workspaces": [
    "packages/core",
    "packages/protocol-native"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -b",
    "dev": "ts-node src/index.ts",
    "test": "jest --config jest.config.js",
    "test:agents": "jest --config jest.config.js tests/agents.test.ts",
    "sim": "ts-node agents/scenarios/run-all.ts",
    "sim:scenario": "ts-node agents/scenarios/run-all.ts",
    "sim:live": "ts-node agents/scenarios/run-live.ts",
    "lint": "eslint src/ packages/ --ext .ts",
    "start": "node dist/index.js"
  },
  "keywords": [
    "ai-agent",
    "payment",
    "solana",
    "libp2p",
    "escrow",
    "multi-agent",
    "multi-protocol"
  ],
  "license": "MIT",
  "dependencies": {
    "@chainsafe/libp2p-noise": "^16.1.0",
    "@coral-xyz/anchor": "^0.30.1",
    "@libp2p/interface": "^2.6.0",
    "@libp2p/tcp": "^10.1.4",
    "@libp2p/websockets": "^9.2.4",
    "@noble/curves": "^1.8.1",
    "@noble/hashes": "^1.7.1",
    "@solana/spl-token": "^0.4.12",
    "@solana/web3.js": "^1.98.0",
    "libp2p": "^2.8.2",
    "uint8arrays": "^5.1.0",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.10",
    "@types/uuid": "^10.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  }
}
